    "def reverse_string(s):\n",
    "    return s[::-1]  # reverse each string\n",
    "\n",
    "fruits = [\"apple\", \"banana\", \"cherry\"]\n",
    "sorted_list = sorted(fruits, key=reverse_string)\n",
    "print(sorted_list)\n"
   ]
  }
